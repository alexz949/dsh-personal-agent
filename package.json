{
  "name": "dsh-personal-agent",
  "version": "0.21.7",
  "description": "A personal assistant for DeepSeek Harness (DSH) on macOS: Apple Calendar, Reminders, Notes and Mail (read and drafts, never sends), a 今日 sticky note, a weekly work journal, arXiv and BibTeX helpers, personalities, and a home that DSH opens on.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "personal-assistant",
    "macos",
    "apple-reminders",
    "apple-calendar"
  ],
  "homepage": "https://github.com/alexz949/dsh-personal-agent#readme",
  "bugs": {
    "url": "https://github.com/alexz949/dsh-personal-agent/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexz949/dsh-personal-agent.git"
  },
  "license": "MIT",
  "author": "alexz949",
  "type": "module",
  "os": [
    "darwin"
  ],
  "files": [
    "CHANGELOG.md",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "SECURITY.md",
    "LICENSE",
    "lib",
    "helper/PersonalAgentHelper.app"
  ],
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./notify": "./lib/notify.js",
    "./apple": "./lib/apple.js",
    "./arxiv": "./lib/arxiv.js",
    "./bib": "./lib/bib.js",
    "./log": "./lib/log.js",
    "./config": "./lib/config.js",
    "./home": "./lib/home.js",
    "./today": "./lib/today.js",
    "./journal": "./lib/journal.js",
    "./browser": "./lib/browser.js",
    "./tasks": "./lib/tasks.js",
    "./sensitive": "./lib/sensitive.js",
    "./secrets": "./lib/secrets.js",
    "./when": "./lib/when.js"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "PERSONAL_AGENT_CONFIG=/nonexistent/personal-agent-config.json node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.3 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-api-workspace-files",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
